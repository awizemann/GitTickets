# For local `wrangler dev`, copy this to .dev.vars (Wrangler reads it
# automatically). For production deploys, use `wrangler secret put` for the
# four secrets; GITHUB_OWNER, GITHUB_REPO and GITTICKETS_R2_PUBLIC_BASE_URL
# are public and belong in [vars] in wrangler.toml.
#
# Same env vars as the Vercel template. See ../vercel/.env.example for the
# detailed setup notes (GitHub App creation, base64-wrapping the PEM, etc.).

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_INSTALLATION_ID=
GITHUB_OWNER=
GITHUB_REPO=

GITTICKETS_SHARED_SECRET=

# Optional — R2 public base URL when you've connected a custom domain to
# the bucket. Without this the relay builds image URLs on an `.invalid`
# host, so attachments are visibly broken rather than silently wrong.
# GITTICKETS_R2_PUBLIC_BASE_URL=

# Optional rate-limit knobs. Defaults live in [vars] in wrangler.toml; a
# value here overrides them for `wrangler dev`. Writes (/report, /attachment)
# and reads (/my-issues, /comments) use separate hourly buckets.
# GITTICKETS_IP_HOURLY_LIMIT=30
# GITTICKETS_DEVICE_HOURLY_LIMIT=10
# GITTICKETS_READ_IP_HOURLY_LIMIT=60
# GITTICKETS_READ_DEVICE_HOURLY_LIMIT=30
